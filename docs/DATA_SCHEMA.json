{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lutelute/All-Japan-Grid/docs/DATA_SCHEMA.json",
  "title": "All-Japan-Grid Unified Distribution Schema",
  "description": "JSON Schema (draft 2020-12) for the DISTRIBUTION layer of the All-Japan-Grid dataset. Validates substations / lines / plants FeatureCollections. The human-readable contract and the raw->distribution transform rules live in config/data_schema.yaml. This schema validates the *distribution* layer only (clean, WGS84 lon/lat, voltage in kV, missing=null, internal meta prefixed with '_', enrichment fields optional). Use $ref '#/$defs/substations_fc' | '#/$defs/lines_fc' | '#/$defs/plants_fc' to validate a single kind; the root oneOf accepts any of the three.",
  "schema_version": "1.0.0",

  "oneOf": [
    { "$ref": "#/$defs/substations_fc" },
    { "$ref": "#/$defs/lines_fc" },
    { "$ref": "#/$defs/plants_fc" }
  ],

  "$defs": {

    "crs_member": {
      "title": "GeoJSON CRS member (WGS84 lon/lat)",
      "type": "object",
      "properties": {
        "type": { "const": "name" },
        "properties": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "enum": [
                "urn:ogc:def:crs:OGC:1.3:CRS84",
                "urn:ogc:def:crs:EPSG::4326"
              ]
            }
          },
          "required": ["name"]
        }
      },
      "required": ["type", "properties"]
    },

    "lonlat": {
      "title": "WGS84 coordinate [lon, lat]",
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180, "description": "longitude (deg)" },
        { "type": "number", "minimum": -90, "maximum": 90, "description": "latitude (deg)" }
      ],
      "items": { "type": "number" }
    },

    "point_geometry": {
      "type": "object",
      "properties": {
        "type": { "const": "Point" },
        "coordinates": { "$ref": "#/$defs/lonlat" }
      },
      "required": ["type", "coordinates"]
    },

    "linestring_geometry": {
      "type": "object",
      "properties": {
        "type": { "const": "LineString" },
        "coordinates": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/lonlat" }
        }
      },
      "required": ["type", "coordinates"]
    },

    "polygon_geometry": {
      "type": "object",
      "properties": {
        "type": { "const": "Polygon" },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 4,
            "items": { "$ref": "#/$defs/lonlat" }
          }
        }
      },
      "required": ["type", "coordinates"]
    },

    "multipolygon_geometry": {
      "type": "object",
      "properties": {
        "type": { "const": "MultiPolygon" },
        "coordinates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 4,
              "items": { "$ref": "#/$defs/lonlat" }
            }
          }
        }
      },
      "required": ["type", "coordinates"]
    },

    "voltage_kv": {
      "description": "Nominal voltage in kV (max of all levels). null when unknown.",
      "type": ["number", "null"],
      "exclusiveMinimum": 0,
      "maximum": 1100
    },

    "voltage_kv_all": {
      "description": "All voltage levels in kV, sorted descending. One-item array for single-level elements. null when unknown.",
      "type": ["array", "null"],
      "minItems": 1,
      "items": { "type": "number", "exclusiveMinimum": 0, "maximum": 1100 }
    },

    "frequency_hz": {
      "description": "Operating frequency (Hz). 50 (east) or 60 (west), or null.",
      "type": ["number", "null"],
      "enum": [50, 60, null]
    },

    "fuel_type": {
      "description": "Normalised primary generation fuel. Unrecognised raw values map to 'unknown'.",
      "type": "string",
      "enum": ["solar", "wind", "hydro", "geothermal", "biomass", "waste",
               "gas", "oil", "coal", "nuclear", "battery", "unknown"]
    },

    "enrichment_method": {
      "description": "Provenance of enrichment. Optional advisory metadata.",
      "type": ["string", "null"],
      "enum": ["geocode_promotion", "endpoint_matching", "nominatim",
               "p03", "jrp_lite", "overpass", null]
    },

    "name_source": {
      "description": "How the display name was obtained. Optional advisory metadata. Enum is grounded in the observed raw value universe across all 10 regions (substations: geocoded, name:en; lines: operator_voltage, endpoints, regional_fallback; plants: geocoded, fallback).",
      "type": ["string", "null"],
      "enum": ["geocoded", "name:en", "operator_voltage", "endpoints",
               "regional_fallback", "fallback", null]
    },

    "region_key": {
      "description": "EPCO region key.",
      "type": "string",
      "enum": ["hokkaido", "tohoku", "tokyo", "chubu", "hokuriku",
               "kansai", "chugoku", "shikoku", "kyushu", "okinawa"]
    },

    "_str_or_null": { "type": ["string", "null"] },

    "substations_properties": {
      "title": "Distribution substation properties",
      "type": "object",
      "properties": {
        "name":              { "type": "string", "minLength": 1 },
        "name_en":           { "$ref": "#/$defs/_str_or_null" },
        "name_ja":           { "$ref": "#/$defs/_str_or_null" },
        "operator":          { "$ref": "#/$defs/_str_or_null" },
        "operator_en":       { "$ref": "#/$defs/_str_or_null" },
        "operator_wikidata": { "$ref": "#/$defs/_str_or_null" },
        "function": {
          "type": ["string", "null"],
          "enum": ["transmission", "distribution", "minor_distribution",
                   "generation", "industrial", "traction", "transition",
                   "converter", "compensation", "switching", "rail",
                   "generic", "unknown", null]
        },
        "voltage_kv":      { "$ref": "#/$defs/voltage_kv" },
        "voltage_kv_all":  { "$ref": "#/$defs/voltage_kv_all" },
        "frequency_hz":    { "$ref": "#/$defs/frequency_hz" },
        "ref":             { "$ref": "#/$defs/_str_or_null" },
        "source":          { "$ref": "#/$defs/_str_or_null" },

        "_region":         { "$ref": "#/$defs/region_key" },
        "_display_name":   { "$ref": "#/$defs/_str_or_null" },
        "_name_source":    { "$ref": "#/$defs/name_source" },
        "_enriched_by":    { "$ref": "#/$defs/enrichment_method" },
        "_centroid":       { "anyOf": [ { "$ref": "#/$defs/lonlat" }, { "type": "null" } ] }
      },
      "required": ["name", "_region"],
      "additionalProperties": false
    },

    "lines_properties": {
      "title": "Distribution line properties",
      "type": "object",
      "properties": {
        "name":              { "type": "string", "minLength": 1 },
        "name_en":           { "$ref": "#/$defs/_str_or_null" },
        "operator":          { "$ref": "#/$defs/_str_or_null" },
        "operator_en":       { "$ref": "#/$defs/_str_or_null" },
        "operator_wikidata": { "$ref": "#/$defs/_str_or_null" },
        "voltage_kv":        { "$ref": "#/$defs/voltage_kv" },
        "voltage_kv_all":    { "$ref": "#/$defs/voltage_kv_all" },
        "current_type":      { "type": ["string", "null"], "enum": ["ac", "dc", null] },
        "frequency_hz":      { "$ref": "#/$defs/frequency_hz" },
        "circuits":          { "type": ["integer", "null"], "minimum": 0 },
        "cables":            { "type": ["integer", "null"], "minimum": 0 },
        "wires":             { "$ref": "#/$defs/_str_or_null" },
        "ref":               { "$ref": "#/$defs/_str_or_null" },
        "source":            { "$ref": "#/$defs/_str_or_null" },

        "_region":           { "$ref": "#/$defs/region_key" },
        "_name_source":      { "$ref": "#/$defs/name_source" },
        "_enriched_by":      { "$ref": "#/$defs/enrichment_method" }
      },
      "required": ["name", "_region"],
      "additionalProperties": false
    },

    "plants_properties": {
      "title": "Distribution plant properties",
      "type": "object",
      "properties": {
        "name":           { "type": "string", "minLength": 1 },
        "name_en":        { "$ref": "#/$defs/_str_or_null" },
        "name_ja":        { "$ref": "#/$defs/_str_or_null" },
        "operator":       { "$ref": "#/$defs/_str_or_null" },
        "fuel_type":      { "$ref": "#/$defs/fuel_type" },
        "capacity_mw":    { "type": ["number", "null"], "exclusiveMinimum": 0 },
        "voltage_kv":     { "$ref": "#/$defs/voltage_kv" },
        "voltage_kv_all": { "$ref": "#/$defs/voltage_kv_all" },

        "_region":          { "$ref": "#/$defs/region_key" },
        "_region_ja":       { "$ref": "#/$defs/_str_or_null" },
        "_category":        { "type": ["string", "null"], "enum": ["utility", "ipp", "unknown", null] },
        "_fuel_color":      { "type": ["string", "null"], "pattern": "^#[0-9a-fA-F]{6}$" },
        "_display_name":    { "$ref": "#/$defs/_str_or_null" },
        "_name_source":     { "$ref": "#/$defs/name_source" },
        "_enriched_by":     { "$ref": "#/$defs/enrichment_method" },
        "_p03_distance_km": { "type": ["number", "null"], "minimum": 0 },
        "osm_id":           { "type": ["integer", "null"], "minimum": 0 },
        "osm_type":         { "type": ["string", "null"], "enum": ["node", "way", "relation", null] }
      },
      "required": ["name", "fuel_type", "_region"],
      "additionalProperties": false
    },

    "substation_feature": {
      "type": "object",
      "properties": {
        "type": { "const": "Feature" },
        "id": { "type": ["string", "integer"] },
        "geometry": {
          "oneOf": [
            { "$ref": "#/$defs/point_geometry" },
            { "$ref": "#/$defs/polygon_geometry" },
            { "$ref": "#/$defs/multipolygon_geometry" }
          ]
        },
        "properties": { "$ref": "#/$defs/substations_properties" }
      },
      "required": ["type", "geometry", "properties"]
    },

    "line_feature": {
      "type": "object",
      "properties": {
        "type": { "const": "Feature" },
        "id": { "type": ["string", "integer"] },
        "geometry": { "$ref": "#/$defs/linestring_geometry" },
        "properties": { "$ref": "#/$defs/lines_properties" }
      },
      "required": ["type", "geometry", "properties"]
    },

    "plant_feature": {
      "type": "object",
      "properties": {
        "type": { "const": "Feature" },
        "id": { "type": ["string", "integer"] },
        "geometry": { "$ref": "#/$defs/point_geometry" },
        "properties": { "$ref": "#/$defs/plants_properties" }
      },
      "required": ["type", "geometry", "properties"]
    },

    "substations_fc": {
      "title": "Substations FeatureCollection",
      "type": "object",
      "properties": {
        "type": { "const": "FeatureCollection" },
        "name": { "type": "string" },
        "crs": { "$ref": "#/$defs/crs_member" },
        "features": {
          "type": "array",
          "items": { "$ref": "#/$defs/substation_feature" }
        }
      },
      "required": ["type", "features"]
    },

    "lines_fc": {
      "title": "Lines FeatureCollection",
      "type": "object",
      "properties": {
        "type": { "const": "FeatureCollection" },
        "name": { "type": "string" },
        "crs": { "$ref": "#/$defs/crs_member" },
        "features": {
          "type": "array",
          "items": { "$ref": "#/$defs/line_feature" }
        }
      },
      "required": ["type", "features"]
    },

    "plants_fc": {
      "title": "Plants FeatureCollection",
      "type": "object",
      "properties": {
        "type": { "const": "FeatureCollection" },
        "name": { "type": "string" },
        "crs": { "$ref": "#/$defs/crs_member" },
        "features": {
          "type": "array",
          "items": { "$ref": "#/$defs/plant_feature" }
        }
      },
      "required": ["type", "features"]
    }
  }
}
