# CIM/CGMES export — generated RDF/XML (regenerate via scripts/export_cim.py).
# Full national set is ~294 MB; only the okinawa sample + manifest are tracked,
# and the zipped release is published as a GitHub Release asset.
dist/cim/*_EQ.xml
dist/cim/*_GL.xml
!dist/cim/okinawa_EQ.xml
!dist/cim/okinawa_GL.xml
dist/cim/*.zip

# Level-2 CGMES (EQ/TP/SSH/SV/GL per region; regenerate via export_cim_level2.py)
dist/cim_level2/*.xml
!dist/cim_level2/okinawa_L2_EQ.xml
!dist/cim_level2/okinawa_L2_TP.xml
!dist/cim_level2/okinawa_L2_SSH.xml
!dist/cim_level2/okinawa_L2_SV.xml
!dist/cim_level2/okinawa_L2_GL.xml
!dist/cim_level2/AllJapan_EQ_BD.xml
!dist/cim_level2/AllJapan_TP_BD.xml
dist/cim_level2/*.zip

